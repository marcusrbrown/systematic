{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  description: ['Use the config preset for the @fro.bot/systematic repository'],
  extends: [
    'local>marcusrbrown/renovate-config',
    'github>sanity-io/renovate-config:semantic-commit-type',
    'customManagers:biomeVersions',
  ],
  // Test fixtures (e.g. the with/without-eval seed app) declare arbitrary,
  // intentionally-fixed dependency versions and are never shipped or installed
  // in CI — Renovate must not try to manage them. Preserves Renovate's default
  // node_modules/bower ignores since setting this key replaces the default.
  ignorePaths: ['**/node_modules/**', '**/bower_components/**', 'tests/**'],
  customManagers: [
    {
      // scripts/opencode-host-pins.json is the single home of the CLI pins the
      // host contract tests run against. Renovate ignores tests/**, so the pins
      // live under scripts/. Each manager tracks one moving pin. The floors
      // ("v1Floor" and "v2Floor") are the oldest supported release of each line,
      // not versions to bump, and neither pattern can match them: each anchors
      // on its own quoted key.
      description: ['Track the current v1 CLI pin (opencode-ai) in the host pin file'],
      customType: 'regex',
      managerFilePatterns: ['/^scripts/opencode-host-pins\\.json$/'],
      matchStrings: ['"v1"\\s*:\\s*"(?<currentValue>\\d+\\.\\d+\\.\\d+)"'],
      depNameTemplate: 'opencode-ai',
      datasourceTemplate: 'npm',
    },
    {
      description: ['Track the v2 CLI pin (@opencode/cli) in the host pin file'],
      customType: 'regex',
      managerFilePatterns: ['/^scripts/opencode-host-pins\\.json$/'],
      matchStrings: ['"v2"\\s*:\\s*"(?<currentValue>\\d+\\.\\d+\\.\\d+)"'],
      depNameTemplate: '@opencode/cli',
      datasourceTemplate: 'npm',
    },
    {
      // The host-support rows in src/lib/connect-config.ts name the hosts the
      // read-only researcher was proven on. The Host Contract jobs re-prove each
      // pin, so a row follows its pin and bumps in the same group PR. Renovate
      // reads the annotation above each row's version. The Claude Code row has
      // no package to bump and carries no annotation.
      description: ['Track the host versions in the ce:connect host-support rows'],
      customType: 'regex',
      managerFilePatterns: ['/^src/lib/connect-config\\.ts$/'],
      matchStrings: [
        '//\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*version:\\s*\'(?<currentValue>\\d+\\.\\d+\\.\\d+)\'',
      ],
    },
    {
      // .github/workflows/connect.yaml pins the Systematic release the scheduled
      // run installs, in `env.SYSTEMATIC_VERSION`. Renovate reads the annotation
      // on the line above it. The bfra-me preset's generic `*_VERSION` manager
      // expects a trailing same-line comment and would capture the quotes, so it
      // does not read this line.
      description: ['Track the Systematic release pinned in the ce:connect workflow'],
      customType: 'regex',
      managerFilePatterns: ['/^\\.github/workflows/connect\\.yaml$/'],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)[ \\t]*\\n[ \\t]*SYSTEMATIC_VERSION:\\s*["\']?(?<currentValue>\\d+\\.\\d+\\.\\d+)["\']?',
      ],
    },
  ],
  packageRules: [
    {
      // bfra-me/renovate-action sets RENOVATE_BINARY_SOURCE=install, so
      // Renovate's built-in artifact update path calls `install-tool bun <ver>`
      // before regenerating bun.lock. That fails in this environment; the
      // postUpgradeTasks `bun install` below regenerates bun.lock instead.
      matchManagers: ['bun', 'npm'],
      skipArtifactsUpdate: true,
    },
    {
      description:
        'Keep @types/node on the Node major that CI and the release job run. Bump it together with node-version in the workflows.',
      matchPackageNames: ['@types/node'],
      allowedVersions: '<25',
    },
    {
      description: 'Only allow LTS versions of Node.js in GitHub Actions',
      matchManagers: ['github-actions'],
      matchPackageNames: ['node'],
      allowedVersions: '/^([0-9]*[02468])$/',
    },
    {
      // The connect.yaml pin is a CI input, not a change to the shipped package, so
      // its bump is a non-releasing `ci` commit. No minimumReleaseAge applies: the
      // marcusrbrown preset clears it for `@fro.bot/**`. Renovate does not skip a
      // regex manager's dependency because this repository publishes it.
      matchManagers: ['custom.regex'],
      matchPackageNames: ['@fro.bot/systematic'],
      semanticCommitType: 'ci',
    },
    {
      matchPackageNames: [
        '@semantic-release/{/,}**',
        'conventional-changelog-conventionalcommits',
        'semantic-release',
        'semantic-release-export-data',
      ],
      semanticCommitType: 'build',
    },
    {
      // Let release-pipeline packages settle before they reach the release job. A
      // broken same-day publish (e.g. semantic-release 25.0.4 shipped a missing
      // @semantic-release/core import) would otherwise break Perform Release before
      // upstream ships a fix.
      matchPackageNames: ['@semantic-release/{/,}**', 'conventional-changelog-conventionalcommits', 'semantic-release', 'semantic-release-export-data'],
      minimumReleaseAge: '3 days',
    },
    {
      matchPackageNames: ['conventional-changelog-conventionalcommits', 'semantic-release'],
      matchUpdateTypes: ['major'],
      groupName: 'semantic-release and conventionalcommits',
      semanticCommitType: 'feat',
    },
    {
      // `opencode-ai` is the unscoped v1 CLI package, which `@opencode-ai/{/,}**`
      // does not match. Listing it here puts the pin file's v1 bump in the same
      // PR as the `@opencode-ai/sdk` and `@opencode-ai/plugin` devDependencies.
      matchPackageNames: ['@opencode-ai/{/,}**', 'opencode-ai'],
      groupName: 'OpenCode',
      semanticCommitType: 'build',
    },
    {
      // The v2 CLI pin and the `@opencode/sdk`, `@opencode/plugin` and
      // `@opencode/client` devDependencies bump together, apart from v1.
      matchPackageNames: ['@opencode/{/,}**'],
      groupName: 'OpenCode v2',
      semanticCommitType: 'build',
    },
    {
      matchPackageNames: ['@earendil-works/{/,}**'],
      groupName: 'Pi',
      semanticCommitType: 'build',
    },
    {
      // customManagers:biomeVersions reads the version out of biome.json's
      // $schema URL and reports it as the npm package @biomejs/biome, the same
      // dependency the npm manager tracks in package.json. Grouping them puts
      // both bumps in one PR so the schema never drifts from the installed
      // release.
      matchPackageNames: ['@biomejs/biome'],
      groupName: 'Biome',
    },
  ],
  postUpgradeTasks: {
    // `bun run fix` runs Biome lint --fix to auto-correct formatting drift.
    // `bun run postupgrade` builds, then regenerates every generated surface through
    // `bun run surfaces:regen` (the list lives in scripts/lib/generated-surfaces.ts):
    // skills/agent-browser/SKILL.md from the pinned package, the config and review
    // JSON schemas from zod's toJSONSchema output, the registry, the Pi persona
    // fixtures and the rest. A bump that changes any of them lands the regenerated
    // file in the same Renovate PR instead of failing the drift gates.
    commands: ['bun install', 'bun run fix', 'bun run postupgrade'],
    executionMode: 'branch',
  },
}

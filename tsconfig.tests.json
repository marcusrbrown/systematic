{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "allowImportingTsExtensions": true,
    "declarationDir": null,
    "outDir": null
  },
  "include": ["src/**/*", "scripts/**/*", "tests/**/*", "docs/scripts/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "claude-code",
    "docs/dist",
    "docs/node_modules",
    ".slim"
  ]
}

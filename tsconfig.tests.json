{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    // Temporary: silences ~44 files of TS5097 noise from `.ts`-suffixed
    // relative imports used throughout tests/. Drop once #897's burn-down
    // removes or rewrites those imports.
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*", "scripts/**/*", "tests/**/*", "docs/scripts/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "claude-code",
    "docs/dist",
    "docs/node_modules",
    ".slim"
  ]
}

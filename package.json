{
  "name": "@fro.bot/systematic",
  "version": "0.0.0-semantic-release",
  "description": "Compound-engineering loops for OpenCode, Pi, and Claude Code",
  "type": "module",
  "homepage": "https://fro.bot/systematic",
  "main": "./dist/index.js",
  "bin": {
    "systematic": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "pi": {
    "extensions": [
      "./dist/pi.js"
    ],
    "skills": [
      "./skills"
    ],
    "subagents": {
      "agents": [
        "./dist/pi-subagents/agents"
      ]
    }
  },
  "files": [
    "dist",
    "skills",
    "agents",
    "ATTRIBUTIONS.md",
    "HARNESSES.md"
  ],
  "workspaces": [
    "docs"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "bun run clean && bun build src/index.ts src/cli.ts --outdir dist --target bun --splitting --external @opencode-ai/plugin --external js-yaml && bun build src/pi.ts --outdir dist --target node --external @earendil-works/pi-coding-agent --external typebox --external jsonc-parser && tsc --emitDeclarationOnly && bun scripts/build-pi-package-agents.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:all": "bun test",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "typecheck:all": "tsc -p tsconfig.tests.json",
    "lint": "biome check .",
    "fix": "bun run lint --fix",
    "docs:dev": "bun run --cwd docs dev",
    "docs:build": "bun run docs:generate && bun run --cwd docs build",
    "docs:preview": "bun run --cwd docs preview",
    "docs:verify": "bun install --frozen-lockfile && bun run --cwd docs playwright install --with-deps chromium && bun run docs:build",
    "config-reference:generate": "bun docs/scripts/generate-config-reference.ts",
    "config-reference:drift": "bun docs/scripts/generate-config-reference.ts --check",
    "docs:generate": "bun docs/scripts/generate-stats.ts && bun docs/scripts/transform-content.ts && bun scripts/generate-config-schema.ts && bun docs/scripts/generate-config-reference.ts && bun docs/scripts/generate-release-notes.ts && bun docs/scripts/generate-changelog-page.ts",
    "schema:generate": "bun scripts/generate-config-schema.ts",
    "schema:drift": "bun scripts/generate-config-schema.ts --check",
    "review-schema:generate": "bun scripts/generate-review-artifact-schema.ts",
    "review-schema:drift": "bun scripts/generate-review-artifact-schema.ts --check",
    "ce-review-validator:build": "bun scripts/generate-ce-review-validator.ts",
    "ce-review-validator:drift": "bun scripts/generate-ce-review-validator.ts --check",
    "agent-browser:build": "bun scripts/generate-agent-browser-skill.ts",
    "agent-browser:drift": "bun scripts/generate-agent-browser-skill.ts --check",
    "pi-personas:generate": "bun scripts/generate-pi-subagents-personas.ts",
    "pi-personas:drift": "bun scripts/generate-pi-subagents-personas.ts --check",
    "registry:build": "bun scripts/build-registry.ts",
    "registry:generate": "bun scripts/generate-registry.ts",
    "registry:drift": "bun scripts/generate-registry.ts --check",
    "registry:validate": "bun scripts/build-registry.ts --validate-only",
    "surfaces:regen": "bun scripts/generated-surfaces.ts regen",
    "surfaces:drift": "bun scripts/generated-surfaces.ts drift",
    "surfaces:affected": "bun scripts/generated-surfaces.ts affected",
    "claude-code:build": "bun scripts/build-claude-code-plugin.ts",
    "postupgrade": "bun run build && bun run surfaces:regen",
    "prepublishOnly": "bun run build && bun run schema:generate"
  },
  "keywords": [
    "opencode",
    "plugin",
    "ai",
    "workflow",
    "engineering",
    "pi-package"
  ],
  "author": "Marcus R. Brown <human@fro.bot>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcusrbrown/systematic.git"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.1.30",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "typebox": "^1.1.38"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@opencode-ai/plugin": "1.19.4",
    "@opencode-ai/sdk": "1.19.4",
    "@semantic-release/exec": "7.1.0",
    "@tintinweb/pi-subagents": "0.22.0",
    "@types/bun": "latest",
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.6.5",
    "agent-browser": "0.39.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "markdownlint-cli": "0.49.1",
    "rimraf": "6.1.3",
    "semantic-release": "25.0.9",
    "semantic-release-export-data": "1.2.0",
    "typebox": "1.4.3",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "js-yaml": "^4.3.2",
    "jsonc-parser": "^3.3.0",
    "zod": "4.6.7"
  },
  "overrides": {
    "@earendil-works/pi-ai": "1.4.0",
    "brace-expansion": "^5.0.8",
    "conventional-changelog-writer": ">=9",
    "devalue": "^5.9.3",
    "dompurify": "~3.4.17",
    "fast-uri": "~3.1.7",
    "markdown-it": "~14.3.3",
    "smol-toml": "~1.9.0",
    "source-map-js": "^1.2.2",
    "vite": "~8.3.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

{
  "header": {
    "description": "Labelled query set for past-work search over solutions, plans, brainstorms and ideation docs. A query counts as found when at least one path in `relevant` is in the top 5 hits.",
    "authored": "2026-10-31",
    "fields": {
      "id": "unique string",
      "query": "text a person would type; the only input a ranker or baseline run sees",
      "target_kind": "a document kind (solution, plan, brainstorm, ideation) to search, or `any` for all kinds",
      "relevant": "repo-relative {path, kind} entries. Any one in the top 5 counts as found. A superseded document and its successor are both labelled.",
      "source": "`title` (best-matching target shares 3 or more tokens with its title, topic, tags or file name), `paraphrase` (1 or 2 tokens) or `body` (no shared token; the answer is in the document text)",
      "requires_local": "true when a relevant path is a brainstorm. docs/brainstorms/ is untracked, so a clone without it skips only the existence check for those paths.",
      "coverage": "what the query exercises: rejected-or-deferred-brainstorm, completed-plan, ideation, superseded-chain, superseded-plan, mixed-kind, solution",
      "overlap": "stemmed token overlap between the query and the best-matching relevant target: `union` over title, topic, tags and file name, `lenient` adds a 5-character-prefix match"
    },
    "authoring_rules": [
      "Each query was written before the frontmatter title, topic or tags of its target were read. Targets were picked from directory listings, status lines and superseded_by values.",
      "q02 was revised once before labelling: the first wording assumed a deferred brainstorm was never built, but a completed plan implemented it.",
      "q14 to q16 were added after q01 to q13 to lower vocabulary overlap, using the same rules.",
      "Labels were kept outside the repo until baseline B finished. No query or label changed after that run.",
      "Source mix: 9 title, 4 paraphrase, 3 body. The title-sourced queries test vocabulary; the others do not."
    ]
  },

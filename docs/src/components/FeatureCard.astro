---
import type { ComponentProps } from 'astro/types'
import { Icon } from '@astrojs/starlight/components'

type IconName = ComponentProps<typeof Icon>['name']

interface Props {
  icon?: IconName
  title: string
}

const { icon, title } = Astro.props
---

<article class="not-content feature-item">
  <div class="feature-head">
    {icon && (
      <div class="icon-wrap" aria-hidden="true">
        <Icon name={icon} size="1.25rem" class="card-icon" />
      </div>
    )}
    <div class="title" set:html={title} />
  </div>
  <div class="description"><slot /></div>
</article>

<style>
  .feature-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    background-color: transparent;
    border-bottom: 1px solid var(--sl-color-gray-5);
    transition: background-color 180ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .feature-item:last-child {
    border-bottom: none;
  }

  .feature-item:hover {
    background-color: color-mix(in oklab, var(--sl-color-accent) 6%, var(--sl-color-gray-6));
  }

  .feature-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .icon-wrap {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.375rem;
    background-color: color-mix(in oklab, var(--sl-color-accent) 15%, transparent);
    color: var(--sl-color-accent);
  }

  .title {
    margin: 0 !important;
    font-family: var(--sl-font-system);
    font-weight: 600;
    font-size: 1.0625rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--sl-color-white);
  }

  .description {
    margin: 0;
    padding-left: calc(2.25rem + var(--space-3));
  }

  .description :global(p) {
    margin: 0 !important;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }

  @media (max-width: 640px) {
    .feature-item {
      padding: var(--space-5) var(--space-4);
    }

    .description {
      padding-left: 0;
    }
  }
</style>
